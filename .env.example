# Names only. Put real values in .env (gitignored).
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=
STOPPROOF_MODEL=nvidia/nemotron-3-super-120b-a12b
STOPPROOF_LOG_LEVEL=INFO
# Optional: trace every Nemotron call in LangSmith (model proposals stay auditable; the verdict path never touches it)
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=stopproof
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional: ground analysis/repair prompts in real library documentation (Tavily search)
# TAVILY_API_KEY=
# Optional: "Request human expert review" on CANNOT ESTABLISH runs (Tendem MCP)
# TENDEM_API_KEY=
# Optional: also fan live-demo sends out to a public ntfy.sh topic (the app's own inbox works without it)
# STOPPROOF_NTFY=1
# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes
# STOPPROOF_SANDBOX=nebius            # nebius (default) or local
# STOPPROOF_SANDBOX_IMAGE=python:3.12-slim
